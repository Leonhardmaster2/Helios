#
# Generates shaders_embedded.hpp/.cpp from the compiled SPIR-V files so the
# runtime never reads shader files from disk (self-contained binaries).

file(GLOB HELIOS_SPV_FILES "${HELIOS_SHADER_DIR}/*.spv")
list(SORT HELIOS_SPV_FILES)

set(header_lines "// Generated by cmake/gen_shader_embed.cmake — do not edit.\n")
string(APPEND header_lines "// SPDX-License-Identifier: AGPL-3.0-only\n")
string(APPEND header_lines "#pragma once\n\n")
string(APPEND header_lines "#include <cstddef>\n\n")
string(APPEND header_lines "namespace helios::shaders::embedded {\n")
string(APPEND header_lines "struct EmbeddedShader {\n")
string(APPEND header_lines "    char const* name;\n")
string(APPEND header_lines "    unsigned char const* data;\n")
string(APPEND header_lines "    std::size_t size;\n")
string(APPEND header_lines "};\n")
string(APPEND header_lines "extern EmbeddedShader const kShaders[];\n")
string(APPEND header_lines "extern std::size_t const kShaderCount;\n")
string(APPEND header_lines "} // namespace helios::shaders::embedded\n")

set(cpp_lines "// Generated by cmake/gen_shader_embed.cmake — do not edit.\n")
string(APPEND cpp_lines "// SPDX-License-Identifier: AGPL-3.0-only\n")
string(APPEND cpp_lines "#include \"shaders_embedded.hpp\"\n\n")
string(APPEND cpp_lines "namespace helios::shaders::embedded {\n")
set(array_entries)
foreach(spv IN LISTS HELIOS_SPV_FILES)
  get_filename_component(fname "${spv}" NAME)
  string(REPLACE "." "_" sym "${fname}")
  string(APPEND cpp_lines "static unsigned char const k${sym}[] = {\n")
  file(READ "${spv}" hex HEX)
  string(LENGTH "${hex}" hex_len)
  set(byte_index 0)
  while(byte_index LESS hex_len)
    string(SUBSTRING "${hex}" ${byte_index} 2 byte)
    string(APPEND cpp_lines "    0x${byte},")
    math(EXPR byte_index "${byte_index} + 2")
    if(NOT byte_index LESS hex_len)
      string(APPEND cpp_lines "\n")
    endif()
  endwhile()
  string(APPEND cpp_lines "};\n")
  string(APPEND array_entries "    {\"${fname}\", k${sym}, sizeof(k${sym})},\n")
endforeach()
string(APPEND cpp_lines "\n")
string(APPEND cpp_lines "EmbeddedShader const kShaders[] = {\n")
string(APPEND cpp_lines "${array_entries}" "};\n")
string(APPEND cpp_lines "std::size_t const kShaderCount = ${HELIOS_SPV_COUNT};
")
string(APPEND cpp_lines "} // namespace helios::shaders::embedded\n")

file(WRITE "${HELIOS_EMBED_HPP}" "${header_lines}")
file(WRITE "${HELIOS_EMBED_CPP}" "${cpp_lines}")
message(STATUS "embedded shader data: ${HELIOS_SPV_COUNT} shaders")
